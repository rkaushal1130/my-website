datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. ENUMS
// ==========================================

enum UserRole {
  ADMIN
  USER
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum ApplicationStatus {
  RECEIVED
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
}

// ==========================================
// 2. USER MODEL
// ==========================================

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// ==========================================
// 3. CONTACT MESSAGE MODEL
// ==========================================

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  company   String?
  service   String?
  message   String        @db.Text
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

// ==========================================
// 4. PROJECT MODEL
// ==========================================

model Project {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  image       String?
  category    String
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([featured])
  @@index([published])
  @@index([createdAt])
  @@map("projects")
}

// ==========================================
// 5. JOB MODEL
// ==========================================

model Job {
  id             String              @id @default(uuid())
  title          String
  slug           String              @unique
  department     String
  location       String
  employmentType String              @map("employment_type")
  description    String              @db.Text
  requirements   String              @db.Text
  salaryRange    String?             @map("salary_range")
  published      Boolean             @default(false)
  applications   CareerApplication[]
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([department])
  @@index([published])
  @@index([createdAt])
  @@map("jobs")
}

// ==========================================
// 6. CAREER APPLICATION MODEL
// ==========================================

model CareerApplication {
  id          String            @id @default(uuid())
  jobId       String?           @map("job_id")
  job         Job?              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  resumeUrl   String?           @map("resume_url")
  coverLetter String?           @db.Text @map("cover_letter")
  status      ApplicationStatus @default(RECEIVED)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([jobId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("career_applications")
}

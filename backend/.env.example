# NeverQuit.ai Backend Environment Variables Example
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/neverquit_db?schema=public"

# Authentication & Security Secrets (Generate a 64+ char random string in production)
JWT_SECRET="your_secure_jwt_secret_key_here"

# Allowed Frontend Origins (CORS)
FRONTEND_URL="http://localhost:5173"

# Initial Development Admin Credentials (used by Prisma seed)
ADMIN_EMAIL="admin@neverquit.ai"
ADMIN_PASSWORD="YourSecureAdminPasswordHere"

{
  "name": "neverquit-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Avaura Workspace root",
  "scripts": {
    "postinstall": "npm install --prefix my-app",
    "dev": "npm run dev --prefix my-app",
    "dev:frontend": "npm run dev --prefix my-app",
    "dev:backend": "npm run dev --prefix backend",
    "build": "npm install --prefix my-app && npm run build --prefix my-app",
    "build:backend": "npm run build --prefix backend",
    "preview": "npm run preview --prefix my-app"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "mongoose": "^9.10.1"
  }
}
